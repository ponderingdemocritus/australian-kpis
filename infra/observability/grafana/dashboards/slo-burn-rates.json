{
  "uid": "au-kpis-slo-burn-rates",
  "title": "SLO Burn Rates",
  "tags": ["au-kpis", "slo", "alerts"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "API Availability Error Budget Burn",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "au-kpis-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(au_kpis_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(au_kpis_http_requests_total[5m])), 1)) / 0.001",
          "legendFormat": "5m burn"
        },
        {
          "refId": "B",
          "expr": "(sum(rate(au_kpis_http_requests_total{status=~\"5..\"}[1h])) / clamp_min(sum(rate(au_kpis_http_requests_total[1h])), 1)) / 0.001",
          "legendFormat": "1h burn"
        }
      ],
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "API Latency SLO",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "au-kpis-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(au_kpis_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum(rate(au_kpis_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "Freshness Burn",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "au-kpis-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (dataflow) (au_kpis_ingestion_lag_seconds) / 3600",
          "legendFormat": "{{dataflow}} hours"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 }
    },
    {
      "id": 4,
      "title": "Active Page Alerts",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "au-kpis-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\", severity=\"page\"}",
          "format": "table",
          "instant": true
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 }
    }
  ]
}
