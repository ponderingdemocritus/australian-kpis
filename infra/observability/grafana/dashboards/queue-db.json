{
  "uid": "au-kpis-queue-db",
  "title": "Queue and DB",
  "tags": ["au-kpis", "queue", "database"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Queue Depth",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "au-kpis-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "au_kpis_queue_depth",
          "legendFormat": "{{queue}}"
        }
      ],
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Worker Saturation",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "au-kpis-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(au_kpis_ingestion_worker_loops_total[5m])",
          "legendFormat": "worker loops/s"
        }
      ],
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "title": "DB Connections",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "au-kpis-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_activity_count",
          "legendFormat": "{{state}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 }
    },
    {
      "id": 4,
      "title": "DB Up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "au-kpis-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up",
          "legendFormat": "postgres"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 }
    }
  ]
}
