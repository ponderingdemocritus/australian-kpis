            ]
          },
          "status": {
            "description": "`live`, `ready`, `degraded`, or `not_ready`.",
            "type": "string"
          },
          "version": {
            "description": "Immutable build version or git SHA.",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "type": "object"
      },
      "ScoreZone": {
        "description": "APS score zone.",
        "enum": [
          "scarcity",
          "mixed",
          "abundance"
        ],
        "type": "string"
      },
      "ScorecardConfig": {
        "description": "APS config metadata and indicator list.",
