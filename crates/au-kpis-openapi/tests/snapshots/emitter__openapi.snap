          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal error."
          }
        },
        "summary": "`GET /v1/series/{dataflow}/{series_key}`.",
        "tags": [
          "series"
        ]
      }
    },
