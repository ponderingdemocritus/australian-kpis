                  "type": "string"
                }
              }
            },
            "description": "Observation page.",
            "headers": {
              "Cache-Control": {
                "description": "Public CDN cache policy.",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "Weak entity tag for this page.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
