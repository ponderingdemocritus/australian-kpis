              }
            ]
          },
          "series": {
            "$ref": "#/components/schemas/Series",
            "description": "Series metadata."
          }
        },
        "required": [
          "series"
        ],
        "type": "object"
      },
      "SeriesRevisionMetadata": {
        "description": "Revision details for the latest observation returned with a series lookup.",
        "properties": {
          "ingested_at": {
            "description": "When this revision was ingested.",
            "format": "date-time",
            "type": "string"
          },
          "is_revision": {
            "description": "Whether this observation supersedes the original publication.",
            "type": "boolean"
          },
          "revision_no": {
            "description": "Latest revision number for the observation timestamp.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "source_artifact_id": {
            "$ref": "#/components/schemas/ArtifactId",
            "description": "Source artifact that produced this revision."
          }
        },
        "required": [
          "revision_no",
          "is_revision",
          "ingested_at",
          "source_artifact_id"
        ],
        "type": "object"
      },
      "SourceCatalogDataflow": {
        "description": "Governed source-dataflow metadata.",
        "properties": {
          "attribution": {
            "description": "Required attribution.",
            "type": "string"
          },
          "cadence": {
            "description": "Expected source cadence.",
            "type": "string"
          },
          "coverage_state": {
            "description": "Coverage state exposed to catalog consumers.",
            "type": "string"
          },
          "dataflow_id": {
            "description": "Stable dataflow id.",
            "type": "string"
          },
          "fixture_reference": {
            "description": "Repository-relative representative fixture or reviewed snapshot.",
            "type": [
              "string",
              "null"
            ]
          },
          "freshness_policy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SourceFreshnessPolicy",
                "description": "Soft and hard freshness thresholds for active sources."
              }
            ]
          },
          "license": {
            "description": "Source licence or terms identifier.",
            "type": "string"
          },
          "owner_area": {
            "description": "Owning implementation area.",
            "type": "string"
          },
          "owner_role": {
            "description": "Accountable production role, when assigned.",
            "type": [
              "string",
              "null"
            ]
          },
          "request_policy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SourceRequestPolicy",
                "description": "Upstream timeout and rate policy for active sources."
              }
            ]
          },
          "schedule": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SourceSchedule",
                "description": "Durable discovery schedule for active sources."
              }
            ]
          },
          "source_url": {
            "description": "Canonical source and citation URL.",
            "type": "string"
          },
          "status": {
            "description": "Source-register governance status.",
            "type": "string"
          },
          "validation_policy": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SourceValidationPolicy",
                "description": "Range, cardinality, and partial-row policy for active sources."
              }
            ]
          }
        },
        "required": [
          "dataflow_id",
          "status",
          "coverage_state",
          "owner_area",
          "source_url",
          "license",
          "attribution",
          "cadence"
        ],
        "type": "object"
      },
      "SourceCatalogEntry": {
        "description": "One source and its governed dataflows.",
        "properties": {
          "dataflows": {
            "description": "Dataflows governed for this source.",
            "items": {
              "$ref": "#/components/schemas/SourceCatalogDataflow"
            },
            "type": "array"
          },
          "source_id": {
            "description": "Stable source id.",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "dataflows"
        ],
        "type": "object"
      },
      "SourceFreshnessPolicy": {
        "description": "Public source freshness policy.",
        "properties": {
          "hard_after_seconds": {
            "description": "Age in seconds after which data is hard-expired.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "soft_after_seconds": {
            "description": "Age in seconds after which data is soft-stale.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "soft_after_seconds",
          "hard_after_seconds"
        ],
        "type": "object"
      },
      "SourceId": {
        "description": "Identifier for an upstream data source (e.g. `abs`, `rba`, `apra`).",
        "type": "string"
      },
      "SourceRequestPolicy": {
        "description": "Public upstream request policy.",
        "properties": {
          "burst": {
            "description": "Maximum short request burst.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "max_requests_per_minute": {
            "description": "Maximum steady-state requests per minute.",
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          },
          "timeout_seconds": {
            "description": "Per-request timeout in seconds.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "timeout_seconds",
          "max_requests_per_minute",
          "burst"
        ],
        "type": "object"
      },
      "SourceSchedule": {
        "description": "Public source discovery schedule.",
        "properties": {
          "cron": {
            "description": "Five-field cron expression.",
            "type": "string"
          },
          "timezone": {
            "description": "IANA timezone name.",
            "type": "string"
          }
        },
        "required": [
          "cron",
          "timezone"
        ],
        "type": "object"
      },
      "SourceValidationPolicy": {
        "description": "Public source validation policy.",
        "properties": {
          "allow_partial_rows": {
            "description": "Whether partial rows may publish.",
            "type": "boolean"
          },
          "max_series_cardinality": {
            "description": "Maximum series cardinality for one generation.",
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "range_rule": {
            "description": "Named adapter range rule.",
            "type": "string"
          }
        },
        "required": [
          "range_rule",
          "max_series_cardinality",
          "allow_partial_rows"
        ],
        "type": "object"
      },
      "SourcesResponse": {
        "description": "Response envelope for `GET /v1/sources`.",
        "properties": {
          "sources": {
            "description": "Governed sources ordered by source id.",
            "items": {
              "$ref": "#/components/schemas/SourceCatalogEntry"
            },
            "type": "array"
          }
        },
        "required": [
          "sources"
        ],
        "type": "object"
      },
      "SubIndexScore": {
        "description": "Axis-level sub-index score.",
        "properties": {
          "axis": {
            "$ref": "#/components/schemas/Axis",
            "description": "Axis name."
          },
          "components": {
            "description": "Component scores for this axis.",
            "items": {
              "$ref": "#/components/schemas/ComponentScore"
            },
            "type": "array"
          },
          "confidence_band": {
            "$ref": "#/components/schemas/ConfidenceBand",
            "description": "Axis confidence band in the axis scale."
          },
          "coverage_pct": {
            "description": "Weight-aware coverage percentage.",
            "format": "double",
            "type": "number"
          },
          "score": {
            "description": "Axis score (`0..1` for throughput, `-1..1` for orientation).",
            "format": "double",
            "type": "number"
          },
          "weight": {
            "description": "Expected scored weight for this axis.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "axis",
          "score",
          "coverage_pct",
          "weight",
          "confidence_band",
          "components"
        ],
        "type": "object"
      },
      "SubscriptionDetails": {
        "description": "Created webhook subscription details.",
        "properties": {
          "created_at": {
            "description": "UTC creation timestamp.",
            "format": "date-time",
            "type": "string"
          },
          "dataflow_ids": {
            "description": "Dataflow filter attached to the subscription.",
            "items": {
              "$ref": "#/components/schemas/DataflowId"
            },
            "type": "array"
          },
          "id": {
            "description": "Stable subscription id.",
            "format": "uuid",
            "type": "string"
          },
          "status": {
            "description": "Current subscription status.",
            "type": "string"
          },
          "updated_at": {
            "description": "UTC last-update timestamp.",
            "format": "date-time",
            "type": "string"
          },
          "url": {
            "description": "Delivery target URL.",
            "type": "string"
          },
          "verified_at": {
            "description": "UTC endpoint verification time.",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "url",
          "dataflow_ids",
          "status",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "TimePrecision": {
        "description": "Temporal granularity of an observation's timestamp. Matches the SDMX\n`@FREQ` facet on a coarse scale.",
        "enum": [
          "minute",
          "day",
          "week",
          "month",
          "quarter",
          "year"
        ],
        "type": "string"
      },
      "Trend": {
        "description": "Trend arrow comparing the latest score to a prior comparable snapshot.",
        "enum": [
          "up",
          "down",
          "flat",
          "unavailable"
        ],
        "type": "string"
      },
      "ZoneThresholds": {
        "description": "Inclusive upper bounds for the first two APS zones.",
        "properties": {
          "mixed_max": {
            "description": "Maximum mixed score.",
            "format": "double",
            "type": "number"
          },
          "scarcity_max": {
            "description": "Maximum scarcity score.",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "scarcity_max",
          "mixed_max"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Unified API for Australian public economic data.",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache-2.0"
    },
    "title": "Australian KPIs API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/livez": {
      "get": {
        "operationId": "liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeHealthResponse"
                }
              }
            },
            "description": "Process is live."
          }
        },
        "summary": "`GET /livez`.",
        "tags": []
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeHealthResponse"
                }
              }
            },
            "description": "Process is ready or ready with disposable dependency degradation."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeHealthResponse"
                }
              }
            },
            "description": "Durable database/schema dependency is unavailable."
          }
        },
        "summary": "`GET /readyz`.",
        "tags": []
      }
    },
    "/v1/dataflows": {
      "get": {
        "operationId": "listDataflows",
        "parameters": [
          {
            "description": "Optional source id filter, e.g. abs.",
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Optional publication frequency filter.",
            "in": "query",
            "name": "frequency",
            "required": false,
            "schema": {
              "minLength": 1,
              "pattern": "^(annual|quarterly|monthly|weekly|daily|irregular)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataflowsResponse"
                }
              }
            },
            "description": "Dataflow catalog page.",
            "headers": {
              "Cache-Control": {
                "description": "Public CDN cache policy.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid query."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal error."
          }
        },
        "summary": "`GET /v1/dataflows`.",
        "tags": [
          "dataflows"
        ]
      }
    },
    "/v1/dataflows/{id}": {
      "get": {
        "operationId": "getDataflow",
        "parameters": [
          {
            "description": "Dataflow id.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataflowDetailResponse"
                }
              }
            },
            "description": "Dataflow metadata and dimensions.",
            "headers": {
              "Cache-Control": {
                "description": "Public CDN cache policy.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid path parameter."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Dataflow not found."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal error."
          }
        },
        "summary": "`GET /v1/dataflows/{id}`.",
        "tags": [
          "dataflows"
        ]
      }
    },
    "/v1/dataflows/{id}/codelists/{dim}": {
      "get": {
        "operationId": "getDataflowCodelist",
        "parameters": [
          {
            "description": "Dataflow id.",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Dimension id.",
            "in": "path",
            "name": "dim",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DataflowCodelistResponse"
                }
              }
            },
            "description": "Codelist for the requested dimension.",
            "headers": {
              "Cache-Control": {
                "description": "Public CDN cache policy.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid path parameter."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Dataflow or dimension not found."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal error."
          }
        },
        "summary": "`GET /v1/dataflows/{id}/codelists/{dim}`.",
        "tags": [
          "dataflows"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "API is healthy."
          },
          "504": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Request timed out."
          }
        },
        "summary": "`GET /v1/health`.",
        "tags": []
      }
    },
    "/v1/observations": {
      "get": {
        "operationId": "listObservations",
        "parameters": [
          {
            "description": "Required dataflow id, e.g. abs.cpi.",
            "in": "query",
            "name": "dataflow",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Dimension filters as repeated key=value values. The handler also accepts dimensions[region]=AUS.",
            "in": "query",
            "name": "dimensions[]",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          {
            "description": "Inclusive lower time bound as YYYY-MM-DD or RFC3339.",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "format": "date",
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Inclusive upper time bound as YYYY-MM-DD or RFC3339.",
            "in": "query",
            "name": "until",
            "required": false,
            "schema": {
              "format": "date",
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Optional dataflow frequency filter, or weekly/monthly/quarterly rollup grain.",
            "in": "query",
            "name": "frequency",
            "required": false,
            "schema": {
              "minLength": 1,
              "pattern": "^(annual|quarterly|monthly|weekly|daily|irregular)$",
              "type": "string"
            }
          },
          {
            "description": "Response format: json, csv, or parquet.",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "maxLength": 7,
              "minLength": 3,
              "pattern": "^(json|csv|parquet)$",
              "type": "string"
            }
          },
          {
            "description": "Opaque cursor from the previous page.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Page size. JSON/CSV are capped at 10000 rows; Parquet bulk exports are capped at 1000000 rows.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "maximum": 1000000,
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationsResponse"
                }
              },
              "application/vnd.apache.parquet": {
                "schema": {
                  "type": "string"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Observation page.",
            "headers": {
              "Cache-Control": {
                "description": "Public CDN cache policy.",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "Weak entity tag for this page.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "The client's cached page is still fresh.",
            "headers": {
              "Cache-Control": {
                "description": "Public CDN cache policy.",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "Weak entity tag for this page.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid query string."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Dataflow not found."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bulk stream admission capacity is exhausted."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal server error."
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Short-request admission or a durable dependency is unavailable."
          },
          "504": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Request timed out."
          }
        },
        "summary": "`GET /v1/observations`.",
        "tags": [
          "observations"
        ]
      }
    },
    "/v1/openapi.json": {
      "get": {
        "operationId": "openapi",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "Current OpenAPI document."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "OpenAPI generation failed."
          },
          "504": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Request timed out."
          }
        },
        "summary": "`GET /v1/openapi.json`.",
        "tags": []
      }
    },
    "/v1/scorecards/aps/config": {
      "get": {
        "operationId": "getApsScorecardConfig",
        "parameters": [
          {
            "description": "Config version; omitted selects the current version.",
            "in": "query",
            "name": "version",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScorecardConfig"
                }
              }
            },
            "description": "Versioned APS scorecard config.",
            "headers": {
              "Cache-Control": {
                "description": "Public CDN cache policy.",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "Strong entity tag for the config JSON.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "The client's cached config is still fresh.",
            "headers": {
              "Cache-Control": {
                "description": "Public CDN cache policy.",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "Strong entity tag for the config JSON.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal server error."
          }
        },
        "summary": "`GET /v1/scorecards/aps/config`.",
        "tags": [
          "scorecards"
        ]
      }
    },
    "/v1/scorecards/aps/history": {
      "get": {
        "operationId": "listApsScorecardHistory",
        "parameters": [
          {
            "description": "Inclusive lower snapshot date in `YYYY-MM-DD` form.",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Inclusive upper snapshot date in `YYYY-MM-DD` form.",
            "in": "query",
            "name": "until",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "description": "Revision view, defaulting to original as-published values.",
            "in": "query",
            "name": "view",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/HistoryView"
            }
          },
          {
            "description": "Maximum points returned, from 1 through 1,000.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ApsSnapshotSummary"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Time-ordered APS scorecard snapshots.",
            "headers": {
              "Cache-Control": {
                "description": "Public CDN cache policy.",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "Strong entity tag for the history JSON.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "The client's cached history response is still fresh.",
            "headers": {
              "Cache-Control": {
                "description": "Public CDN cache policy.",
                "schema": {
                  "type": "string"
                }
              },
              "ETag": {
                "description": "Strong entity tag for the history JSON.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid query string."
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal server error."
          }
        },
        "summary": "`GET /v1/scorecards/aps/history`.",
        "tags": [
          "scorecards"
        ]
      }
    },
